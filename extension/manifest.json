{
  "manifest_version": 3,
  "name": "CGV IMAX 예매 알림",
  "version": "1.4",
  "description": "CGV IMAX 상영이 열리면 알림을 보내줍니다",
  "permissions": ["alarms", "notifications", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.cgv.co.kr/*",
    "http://www.cgv.co.kr/*",
    "https://cgv.co.kr/*",
    "http://cgv.co.kr/*",
    "https://api.cgv.co.kr/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://cgv.co.kr/cnm/movieBook/*", "https://www.cgv.co.kr/cnm/movieBook/*"],
      "js": ["intercept.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
